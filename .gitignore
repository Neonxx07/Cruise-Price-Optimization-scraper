# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
venv/
.venv/
env/

# Environment
.env
.env.local

# Database -- generated/runtime state (rebuilt by running scans), not source
# data. This is a blanket rule: it also covers SQLite's -shm/-wal sidecar
# files, which mirror live database content just as much as the .db file
# itself.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite3
# ...and any hand-made copy of one. A timestamped backup (e.g.
# cruise_intel.db.backup_20260827_150330) is a full copy of the live
# database and did NOT match the `*.db` rule above -- it slipped through
# on 2026-08-29. Keep these suffix-tolerant.
*.db.backup*
*.db.bak*
*.db.copy*
*.sqlite3.backup*

# Scan output / captured data -- all of this is real, live scrape output
# (real booking IDs, real prices, real portal page captures), regenerated
# by running a scan. Never commit any of it, including subfolders that look
# like "work product" -- if a specific capture is ever needed as a fixture,
# copy just that file into tests/fixtures/ deliberately, with any real
# booking IDs/names replaced by fake ones first.
*.jsonl
/platform/data/
/platform/watch_runs/

# Booking-ID input lists. These are ALLOWLISTED, not blocklisted, and that
# is deliberate: the previous rules named specific files
# (`/platform/watchlist.txt`), and on 2026-08-29 a batch of new ad-hoc
# lists -- Watchlistncl.txt, Watchlistncl_us.txt, Watchlistncl_ca.txt,
# Watchlistncl_recheck.txt, ncl_diag.txt, ncl_pilot.txt -- carried 167 real
# customer booking numbers straight past them. Naming each new file will
# always lose that race, so ignore every loose .txt/.bak under platform/
# and re-admit only the ones that are genuinely source.
# Trailing wildcards matter: a real file was named
# `watchlist.txt.bak_2026-08-17`, which ends in neither `.txt` nor `.bak`.
/platform/*.txt
/platform/*.txt.*
/platform/*.bak*
!/platform/requirements.txt
!/platform/requirements-dev.txt

# Generated reports (CSV/XLSX exports) -- regenerate via a scan, not source data
*.csv
*.xlsx
/platform/reports/

# Local dependency-upgrade backups (pip freeze snapshots) -- not source
.dep_backups/

# Logs
logs/
*.log

# PyInstaller
*.spec

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Playwright traces
playwright-data/

# Browser profile data -- real session cookies, never commit
platform/browser-profile/

# Coverage
htmlcov/
.coverage

# Claude Code local runtime state (session locks, not project source)
.claude/scheduled_tasks.lock
